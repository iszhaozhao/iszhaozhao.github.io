extends includes/layout

block content
    .page(itemscope itemtype='http://schema.org/Blog')
        // 欢迎区域
        .welcome-section
            .welcome-content
                h1.welcome-title 欢迎来到我的博客
                p.welcome-subtitle= theme.welcome_label
                ul.welcome-directions
                    each name in theme.research_directions
                        li= name
        // 最近更新区块
        .recent-updates
            h2.section-title
                i.fas.fa-clock
                |  最近更新
            .posts-container
                each article in page.posts.toArray()
                    if !theme.index_only_academia || article.academia
                        article.post-card(itemscope itemtype='http://schema.org/Article')
                            .post-card-header
                                h2.post-card-title(itemprop='name headline')
                                    a.post-card-link(href=url_for(article.path))= article.title
                                .post-card-meta
                                    time.post-card-date(itemprop='datePublished' datetime=article.date.format('YYYY-MM-DD'))
                                        i.fas.fa-calendar-alt
                                        |  #{article.date.format('YYYY-MM-DD')}
                            .post-card-content(itemprop='description')= academia_excerpt(article, 153)
                            .post-card-footer
                                if article.tags && article.tags.length
                                    .post-card-tags
                                        each tag in article.tags.toArray()
                                            a.post-card-tag(href=url_for(tag.path))
                                                i.fas.fa-tag
                                                |  #{tag.name}
                                a.post-card-readmore(href=url_for(article.path)) 阅读全文 →
        // 更多文章链接
        // 分类和标签快速访问
        .quick-links
            .quick-link-item
                h3.quick-link-title
                    i.fas.fa-folder-open
                    |  分类
                a.quick-link(href=url_for('/categories')) 查看所有分类 →
            .quick-link-item
                h3.quick-link-title
                    i.fas.fa-tags
                    |  标签
                a.quick-link(href=url_for('/tags')) 查看所有标签 →
            .quick-link-item
                h3.quick-link-title
                    i.fas.fa-archive
                    |  归档
                a.quick-link(href=url_for('/archives')) 查看所有文章 →
