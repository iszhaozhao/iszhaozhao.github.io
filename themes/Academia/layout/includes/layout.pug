doctype html
html(lang=config.language)
    head
        meta(charset='UTF-8')
        meta(http-equiv="X-UA-Compatible" content="IE=edge")
        meta(name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5")
        title= config.title
        meta(name="author" content=config.author)
        if config.description
            meta(name="description" content=config.description)
        != favicon_tag(config.favicon || theme.favicon || '/favicon.ico')
        each item in theme.CDN_USE.css
            link(rel='stylesheet', href=url_for(item))
    - const layoutName = (page && page.layout) || ''
    - const fullWidth = is_archive() || is_category() || is_tag() || ['categories', 'tags', 'about'].indexOf(layoutName) !== -1
    body
        header#page_header
            include ./header.pug
        main#page_main(class=fullWidth ? 'full-width' : undefined)
            if !fullWidth
                include ./side-card.pug
            block content
        include ./mobile-nav.pug
        footer#page_footer
            include ./footer.pug
        each item in theme.CDN_USE.js
            script(src=url_for(item))
