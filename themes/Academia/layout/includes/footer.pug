.footer_wrap
    - var now = new Date()
    - var nowYear = now.getFullYear()
    if theme.since && theme.since != nowYear
        .copyright!= `&copy;${theme.since} - ${nowYear} by ${config.author}`
    else
        .copyright!= `&copy;${nowYear} by ${config.author}`
    .theme-info Powered by #[a(target="_blank" href="https://hexo.io" rel="nofollow noopener") Hexo] & #[a(target="_blank" href="https://github.com/PhosphorW/hexo-theme-academia" rel="nofollow noopener") Academia Theme]
